# ─────────────────────────────────────────────────────────────
# CLUB MOMENTOS DISMANT — Variables de Entorno
# Copia este archivo a .env.local y llena los valores reales
# NUNCA subas .env.local a git
# ─────────────────────────────────────────────────────────────

# ── APLICACIÓN ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=genera-un-string-aleatorio-de-64-caracteres-aqui

# ── SUPABASE (Base de Datos + Auth) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # Clave pública (frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # Clave privada (solo servidor)

# ── SUPABASE STORAGE (Almacenamiento de archivos) ──────────
# Nombre del bucket privado en Supabase Storage (crear en el dashboard de Supabase)
SUPABASE_STORAGE_BUCKET=club-momentos

# ── RESEND (Email transaccional) ───────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@clubmomentos.com.mx
RESEND_FROM_NAME=Club Momentos Dismant

# ── FIREBASE (Push Notifications) ──────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNxxx...  # Cloud Messaging > Web Push certificates en Firebase Console
# Admin SDK (solo servidor)
FIREBASE_ADMIN_PROJECT_ID=tu-proyecto-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n"

# ── FACTURAPI (Validación CFDI / SAT) ──────────────────────
FACTURAPI_SECRET_KEY=sk_test_xxxx   # Sandbox: sk_test_ | Producción: sk_live_
DISMANT_RFC=XAXX010101000           # RFC oficial de Dismant

# ── UPSTASH REDIS (Sistema de colas — BullMQ) ──────────────
# REST API (uso general)
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx
# Conexión IORedis para BullMQ workers (Upstash Console → Redis → Connect → Node.js)
UPSTASH_REDIS_HOST=us1-xxx.upstash.io
UPSTASH_REDIS_PASSWORD=xxx
# Auto-aprobar facturas después de validación SAT exitosa (default: false → requiere admin)
INVOICE_AUTO_APPROVE=false

# ── SEGURIDAD DE CRON JOBS ─────────────────────────────────
# Secret para proteger los endpoints de cron. Generar con: openssl rand -base64 32
# En Vercel: este valor se envía automáticamente en el header Authorization de los crons
CRON_SECRET=genera-un-string-aleatorio-aqui

# ── REGLAS DE NEGOCIO ──────────────────────────────────────
POINTS_PER_AMOUNT=100               # Puntos por cada $100 MXN de factura
POINTS_EXPIRY_DAYS=180              # Días antes de que los puntos expiren
WELCOME_BONUS_POINTS=100            # Puntos de bono al registrarse
REVIEW_BONUS_POINTS=5               # Puntos por dejar una reseña con comentario
INVOICE_MAX_AGE_DAYS=90             # Facturas de máximo N días de antigüedad
REVIEW_MIN_COMMENT_LENGTH=20        # Caracteres mínimos para aplicar bono de reseña
