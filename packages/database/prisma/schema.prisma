// ─────────────────────────────────────────────────────────────
// Club Momentos Dismant — Schema de Base de Datos
// Motor: PostgreSQL (Supabase)
// ORM: Prisma
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Requerido por Supabase para migraciones
}

// ─────────────────────────────────────────────────────────────
// ROLES Y PERMISOS
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // owner | admin | employee | member
  createdAt   DateTime @default(now()) @map("created_at")

  members     Member[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String @map("role_id")
  permission String // load_points | approve_invoice | manage_catalog | view_reports | etc.

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, permission])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// MIEMBROS DEL CLUB
// ─────────────────────────────────────────────────────────────

model Member {
  id              String    @id @default(uuid())
  email           String    @unique
  fullName        String    @map("full_name")
  companyName     String    @map("company_name")
  rfc             String    // Compartido entre miembros de la misma empresa, no es único
  locationState   String    @map("location_state")  // Estado de México
  locationCity    String    @map("location_city")   // Ciudad
  phone           String?   @map("phone")           // Celular del miembro
  passwordHash    String?   @map("password_hash")   // Contraseña hasheada (bcrypt)
  affiliate       String    @default("dismant") @map("affiliate") // dismant | lauti
  invitationCode  String?   @map("invitation_code")
  fcmToken        String?   @map("fcm_token")       // Token de Firebase push
  status          String    @default("active")       // active | suspended
  roleId          String    @map("role_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastLoginAt     DateTime? @map("last_login_at")

  role            Role      @relation(fields: [roleId], references: [id])

  // Relaciones
  ledgerEntries   LedgerEntry[]
  invoices        Invoice[]
  redemptions     Redemption[]
  reviews         Review[]
  auditLogs       AuditLog[]  @relation("ActorLogs")
  approvedInvoices  Invoice[]  @relation("ApprovedInvoices")
  verifiedInvoices  Invoice[]  @relation("VerifiedInvoices")
  registeredInvoices Invoice[] @relation("RegisteredInvoices")
  ledgerOperations LedgerEntry[] @relation("OperatorLedger")
  createdPromotions PartnerPromotion[] @relation("CreatedPromotions")
  approvedPromotions PartnerPromotion[] @relation("ApprovedPromotions")
  sentInvitations   Invitation[]
  notifications     Notification[]

  @@index([rfc])
  @@map("members")
}

// ─────────────────────────────────────────────────────────────
// AUTENTICACIÓN — OTP TOKENS
// ─────────────────────────────────────────────────────────────

// Nota: NO tiene relación/FK hacia members.email — el OTP se usa para verificar
// el correo de invitados ANTES de que exista su registro de Member (registro nuevo).
model OtpToken {
  id        String   @id @default(uuid())
  email     String
  codeHash  String   @map("code_hash")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("otp_tokens")
}

// ─────────────────────────────────────────────────────────────
// LEDGER DE PUNTOS (APPEND-ONLY — NUNCA ACTUALIZAR/ELIMINAR)
// ─────────────────────────────────────────────────────────────

model LedgerEntry {
  id             String    @id @default(uuid())
  memberId       String    @map("member_id")
  type           String    // invoice | redemption | welcome_bonus | review_bonus | adjustment
  points         Int       // positivo o negativo
  balanceAfter   Int       @map("balance_after")  // saldo acumulado post-movimiento
  description    String?
  invoiceId      String?   @map("invoice_id")
  redemptionId   String?   @map("redemption_id")
  operatorId     String?   @map("operator_id")   // quién ejecutó la operación
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  member         Member    @relation(fields: [memberId], references: [id])
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  redemption     Redemption? @relation(fields: [redemptionId], references: [id])
  operator       Member?   @relation("OperatorLedger", fields: [operatorId], references: [id])

  @@index([memberId, createdAt(sort: Desc)])
  @@index([type])
  @@index([expiresAt])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────
// FACTURAS CFDI
// ─────────────────────────────────────────────────────────────

model Invoice {
  id               String    @id @default(uuid())
  memberId         String    @map("member_id")
  uuidCfdi         String    @unique @map("uuid_cfdi")  // Folio Fiscal del SAT
  rfcEmisor        String    @map("rfc_emisor")
  rfcReceptor      String    @map("rfc_receptor")
  totalMxn         Decimal   @map("total_mxn") @db.Decimal(12, 2)
  issuedAt         DateTime  @map("issued_at")    // fecha de emisión del CFDI
  paidAt           DateTime? @map("paid_at")      // fecha de pago registrada
  pointsGenerated  Int?      @map("points_generated")
  status           String    @default("pending")  // pending | approved | rejected | cancelled
  satStatus           String?   @map("sat_status")   // vigente | cancelada | no_encontrada
  rejectionReason     String?   @map("rejection_reason")
  approvedBy          String?   @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  xmlStorageKey       String?   @map("xml_storage_key")  // path en Cloudflare R2
  folioReferencia     String?   @map("folio_referencia")  // folio legible del doc físico (ej. FA-1234)
  evidenceKey         String?   @map("evidence_key")       // R2 key de la foto/PDF del documento físico
  // ── Flujo de verificación en dos pasos ──────────────────
  verificationStatus  String    @default("pending") @map("verification_status") // pending | verified
  verifiedBy          String?   @map("verified_by")
  verifiedAt          DateTime? @map("verified_at")
  registeredBy        String?   @map("registered_by") // empleado que registró manualmente
  createdAt           DateTime  @default(now()) @map("created_at")

  member           Member    @relation(fields: [memberId], references: [id])
  approver         Member?   @relation("ApprovedInvoices", fields: [approvedBy], references: [id])
  verifier         Member?   @relation("VerifiedInvoices", fields: [verifiedBy], references: [id])
  registrar        Member?   @relation("RegisteredInvoices", fields: [registeredBy], references: [id])
  ledgerEntries    LedgerEntry[]

  @@index([memberId, status])
  @@index([uuidCfdi])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────
// BANNER GLOBAL DE ANUNCIOS (singleton — solo un registro activo)
// ─────────────────────────────────────────────────────────────

model GlobalBanner {
  id        String   @id @default(uuid())
  message   String
  isActive  Boolean  @default(false) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("global_banners")
}

// ─────────────────────────────────────────────────────────────
// ALIADOS / SOCIOS
// ─────────────────────────────────────────────────────────────

model Partner {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?  @map("logo_url")
  isVerified  Boolean  @default(false) @map("is_verified")
  status      String   @default("active") // active | suspended
  createdAt   DateTime @default(now()) @map("created_at")

  skus        RewardSku[]
  promotions  PartnerPromotion[]

  @@map("partners")
}

// ─────────────────────────────────────────────────────────────
// SKUs DE PREMIOS
// ─────────────────────────────────────────────────────────────

model RewardSku {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  imageUrl              String?  @map("image_url")
  pointsCost            Int      @map("points_cost")
  stock                 Int      @default(0)
  stockAlertThreshold   Int      @default(10) @map("stock_alert_threshold")
  geoType               String   @default("national") @map("geo_type")  // national | local
  geoStates             String[] @map("geo_states")   // array de estados
  geoCities             String[] @map("geo_cities")   // array de ciudades
  isDigital             Boolean  @default(false) @map("is_digital")
  status                String   @default("active")   // active | paused | discontinued
  category              String?
  partnerId             String?  @map("partner_id")
  createdAt             DateTime @default(now()) @map("created_at")

  partner        Partner?     @relation(fields: [partnerId], references: [id])
  redemptions    Redemption[]
  reviews        Review[]
  digitalCodes   DigitalCode[]

  @@index([geoType, status])
  @@map("reward_skus")
}

// ─────────────────────────────────────────────────────────────
// CÓDIGOS DIGITALES (asignación FIFO)
// ─────────────────────────────────────────────────────────────

model DigitalCode {
  id           String    @id @default(uuid())
  skuId        String    @map("sku_id")
  code         String
  assignedTo   String?   @map("assigned_to")  // redemption_id
  assignedAt   DateTime? @map("assigned_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sku          RewardSku  @relation(fields: [skuId], references: [id])
  redemption   Redemption? @relation(fields: [assignedTo], references: [id])

  @@index([skuId, assignedTo])
  @@map("digital_codes")
}

// ─────────────────────────────────────────────────────────────
// CANJES
// ─────────────────────────────────────────────────────────────

model Redemption {
  id           String   @id @default(uuid())
  memberId     String   @map("member_id")
  skuId        String   @map("sku_id")
  pointsSpent  Int      @map("points_spent")
  voucherCode      String?  @map("voucher_code")
  status           String   @default("active")  // active | shipped | used | expired
  deliveryAddress  Json?    @map("delivery_address")  // { full_name, phone, street, colony, city, state, zip, notes? }
  prizeContent     String?  @map("prize_content")     // código/boleto/acceso ingresado por admin al entregar
  prizeFileKey     String?  @map("prize_file_key")    // clave R2 del archivo adjunto (boleto PDF, imagen, etc.)
  shippingInfo     Json?    @map("shipping_info")     // { carrier, tracking_number, tracking_url?, estimated_date?, shipped_at }
  createdAt        DateTime @default(now()) @map("created_at")

  member       Member      @relation(fields: [memberId], references: [id])
  sku          RewardSku   @relation(fields: [skuId], references: [id])
  review       Review?
  ledgerEntries LedgerEntry[]
  digitalCodes  DigitalCode[]

  @@index([memberId])
  @@map("redemptions")
}

// ─────────────────────────────────────────────────────────────
// RESEÑAS DE PREMIOS
// ─────────────────────────────────────────────────────────────

model Review {
  id            String   @id @default(uuid())
  memberId      String   @map("member_id")
  redemptionId  String   @unique @map("redemption_id")
  skuId         String   @map("sku_id")
  rating        Int      // 1–5
  comment       String?
  bonusAwarded  Boolean  @default(false) @map("bonus_awarded")
  createdAt     DateTime @default(now()) @map("created_at")

  member        Member     @relation(fields: [memberId], references: [id])
  redemption    Redemption @relation(fields: [redemptionId], references: [id])
  sku           RewardSku  @relation(fields: [skuId], references: [id])

  @@index([skuId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// PROMOCIONES DE ALIADOS
// ─────────────────────────────────────────────────────────────

model PartnerPromotion {
  id             String   @id @default(uuid())
  partnerId      String   @map("partner_id")
  title          String
  description    String?
  imageUrl       String?  @map("image_url")
  bannerKey      String?  @map("banner_key")
  destinationUrl String?  @map("destination_url")
  geoType        String   @default("national") @map("geo_type")  // national | local
  geoStates      String[] @map("geo_states")
  geoCities      String[] @map("geo_cities")
  validFrom      DateTime @map("valid_from")
  validUntil     DateTime @map("valid_until")
  status         String   @default("draft")  // draft | in_review | approved | active | expired | rejected
  featured       Boolean  @default(false)
  createdBy      String?  @map("created_by")
  approvedBy     String?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  partner        Partner  @relation(fields: [partnerId], references: [id])
  creator        Member?  @relation("CreatedPromotions", fields: [createdBy], references: [id])
  approver       Member?  @relation("ApprovedPromotions", fields: [approvedBy], references: [id])

  @@index([status, validUntil])
  @@map("partner_promotions")
}

// ─────────────────────────────────────────────────────────────
// INVITACIONES
// ─────────────────────────────────────────────────────────────

model Invitation {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  sentBy    String?   @map("sent_by")
  affiliate String    @default("dismant") @map("affiliate")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  sender    Member?   @relation(fields: [sentBy], references: [id])

  @@index([email])
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────
// AUDITORÍA (APPEND-ONLY — NUNCA ACTUALIZAR/ELIMINAR)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String   // ej. "invoice.approved", "points.manual_adjustment"
  targetType String?  @map("target_type")  // "invoice" | "member" | "redemption"
  targetId   String?  @map("target_id")
  metadata   Json?    // datos adicionales del evento
  createdAt  DateTime @default(now()) @map("created_at")

  actor      Member?  @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICACIONES IN-APP
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  memberId  String    @map("member_id")
  type      String                         // invoice.approved | invoice.rejected | points.adjustment | redemption.ready
  title     String
  body      String
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt(sort: Desc)])
  @@map("notifications")
}
